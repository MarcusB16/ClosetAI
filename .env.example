# Copy to .env before running `docker compose up`. Never commit .env.

# Development-only SQL Server SA password (must meet SQL Server complexity rules, and must not contain ';').
MSSQL_SA_PASSWORD=ClosetAI_Dev_Passw0rd!

# Leave empty to use the deterministic rules stylist and fake photo tagger.
# Set to an Anthropic API key to use Claude for styling and photo tagging.
ANTHROPIC_API_KEY=

# Host port for the API.
API_PORT=5080
